# Foresight Environment Variables Template
# ----------------------------------------
# 1. Rename this file to exactly `.env` (or create a new `.env` file)
# 2. Replace the values below with your actual keys from Stripe and Gemini
# 3. Restart the backend server for changes to take effect

# --- AI API Keys ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Stripe Payment Gateway ---
# Get these keys from https://dashboard.stripe.com/apikeys
# Use your "Test mode" keys (sk_test_...) during development!
STRIPE_SECRET_KEY=sk_test_your_real_stripe_secret_key_here

# To test webhooks locally, you need the Stripe CLI: `stripe listen --forward-to localhost:8000/api/v1/billing/webhook`
# The CLI will print a webhook secret (`whsec_...`). Paste it here:
STRIPE_WEBHOOK_SECRET=whsec_your_real_webhook_secret_here

# --- General Configuration ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173
DEBUG=true
